<?xml version="1.0" encoding="utf-8"?>

<robot name="rm_gimbal"
  xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="base_frame2gimbal" default="0 0 0" />
  <xacro:arg name="gimbal2front_camera" default="0.075 0.00 0.064" />
  <xacro:arg name="gimbal2back_camera" default="-0.213 0.03 0.082" />
  <xacro:arg name="rpy" default="0 0 0" />

  <link name="base_frame" />

  <link name="gimbal_link" />

  <joint name="gimbal_joint" type="continuous">
    <origin xyz="$(arg base_frame2gimbal)" rpy="0 0 0" />
    <parent link="base_frame" />
    <child link="gimbal_link" />
  </joint>

  <link name="front_camera_link" />

  <joint name="front_camera_joint" type="fixed">
    <origin xyz="$(arg gimbal2front_camera)" rpy="$(arg rpy) " />
    <parent link="gimbal_link" />
    <child link="front_camera_link" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="front_camera_optical_frame" />

  <joint name="front_camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2 - 3*pi/180} 0 ${-pi/2 - 0.0*pi/180}" />
    <parent link="front_camera_link" />
    <child link="front_camera_optical_frame" />
  </joint>

  <link name="back_camera_link" />

  <joint name="back_camera_joint" type="fixed">
    <origin xyz="$(arg gimbal2back_camera)" rpy="$(arg rpy) " />
    <parent link="gimbal_link" />
    <child link="back_camera_link" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="back_camera_optical_frame" />

  <joint name="back_camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-115*pi/180} 0 ${pi/2}" />
    <parent link="back_camera_link" />
    <child link="back_camera_optical_frame" />
  </joint>

</robot>